# Supabase (lokal: lihat output `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. JANGAN diberi prefiks NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Dipakai untuk QR code dan tautan verifikasi di PDF
NEXT_PUBLIC_APP_URL=

# Tampilkan kotak "Akun demo" di halaman masuk
NEXT_PUBLIC_DEMO_MODE=true

# Hanya untuk skrip reset:demo (koneksi pooler Supabase, server-only)
SUPABASE_DB_URL=

# AI cek dokumen KTP/KK (opsional, server-only, TANPA prefiks NEXT_PUBLIC_).
# Jika AI_ENABLED bukan "true" atau AI_API_KEY kosong, fitur mati dan aplikasi tetap berjalan normal.
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# per percobaan, maks. 2 percobaan (2x nilai ini harus < 30 dtk)
AI_TIMEOUT_MS=12000
AI_MAX_CHECKS_PER_HOUR=20
